{
  "name": "erasmus-upt",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:up": "docker compose up -d --wait db",
    "db:push": "tsx --env-file=.env.local scripts/db-init.ts && drizzle-kit push --force && tsx --env-file=.env.local scripts/db-init.ts",
    "catalogue:import": "tsx scripts/import-catalogue.ts",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "smoke:auth": "tsx --env-file=.env.local scripts/smoke-auth.ts",
    "smoke:catalogue": "tsx --env-file=.env.local scripts/smoke-catalogue.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@google/genai": "3.6.1",
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.1.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
